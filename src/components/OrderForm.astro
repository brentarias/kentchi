---
import { t, type Lang, defaultLang } from '../i18n';

interface Props {
  lang?: Lang;
}

const { lang = defaultLang } = Astro.props;
const i = t(lang);

// Cloudinary on-the-fly transforms: f_auto picks a modern format per browser,
// q_auto compresses, and the width cap keeps the delivered bytes small. Note
// the cap here is a payload optimisation, not the protection boundary — the
// untransformed original is always reachable, so the stored asset itself has to
// satisfy the size rule (see scripts/audit-cloudinary.mjs).
const THUMB = 'f_auto,q_auto,c_fit,w_320,h_320';
const FULL = 'f_auto,q_auto,w_1000';
const cld = (url: string, transform: string) =>
  url.includes('res.cloudinary.com') ? url.replace('/upload/', `/upload/${transform}/`) : url;

// Amazon editions for the two books. Both titles exist in English and Spanish,
// and both pills render on both locales — hiding one edition per page would
// obscure that a translation exists at all. These live here rather than in the
// i18n JSON precisely because they are identical on both locales: duplicating
// four URLs across en.json/es.json would only invite drift. Each edition is
// named in its own language. All are amazon.com (US), which is why the invite
// copy leads with the country.
//
// The `tag=axis0d-20` in every URL is an Amazon Associates affiliate tag; the
// disclosure required by their operating agreement sits at the foot of the
// products fieldset below.
type AmazonEdition = { label: string; url: string };

// Which language editions a given packaging is actually sold in. This is a
// ragged matrix, not a clean product, and the raggedness is real:
//   Shinan Oracle  — bilingual only, both packagings (one guidebook, both languages)
//   Magnetic Magi  — the hardcase box IS the bilingual edition; the cinch bags
//                    are single-language only
//   Worlds Within  — not bilingual at all; you buy one language or the other
//   both books     — English or Spanish
// Rendering one row per language would have turned 8 rows into 15, most of them
// near-duplicates, so edition is a choice *within* a row instead. That also lets
// one submission mix languages — "2 in Spanish and 1 in English" — which a buyer
// otherwise had to split across two visits to two different pages.
type EditionCode = 'bilingual' | 'en' | 'es';
const editionLabels: Record<EditionCode, string> = {
  bilingual: i.order.editionBilingual,
  en: i.order.editionEn,   // endonyms on both locales: a Spanish speaker on the
  es: i.order.editionEs,   // English page still recognises "Español" instantly
};

type Variant = {
  slug: string;
  label: string;
  usd: number | null;
  mxn: number | null;
  box: boolean;
  img: string;
  editions: EditionCode[];
  amazon?: AmazonEdition[];
};
type Group = { key: string; name: string; note: string; variants: Variant[] };

const amazonElEstimado: AmazonEdition[] = [
  { label: 'English', url: 'https://www.amazon.com/Estimado-Unexpected-Encounter-Kent-Osborn/dp/B0H7BL1HNM?crid=1EK7DLEERAMMT&dib=eyJ2IjoiMSJ9.ftiKW8aOA0dxG10prX2WRtWzNmIkwlwe680ZuAJaGuGnQ5v0m5oDAfmHDAzVp2t4y6bghgUmquZy30uC2sQUCX_RAARly1uB-O2RR8Hv0nwBwGDzqc2rzJc50Nd7hi19sDPzbrQZYOD9eLthGZhFZwZ3dAfW1r7nEWXoyodkIDcy_9qlLftFEr571eGI6NYa.QTx7yEAaxiOGR0QFkxJYLkDku-n6aG9UcF95G_ipRr0&dib_tag=se&keywords=el%2Bestimado&qid=1785557966&sprefix=el%2Bestimado%2Caps%2C195&sr=8-1&linkCode=ll2&tag=axis0d-20&linkId=434bcec51ffd9a257bb67f4f9cada9ff&language=en_US&gaOptInStatus=true&ref_=as_li_ss_tl' },
  { label: 'Español', url: 'https://www.amazon.com/Estimado-Encuentro-Inesperado-Kent-Osborn/dp/B0H6PVH4RC?crid=1EK7DLEERAMMT&dib=eyJ2IjoiMSJ9.ftiKW8aOA0dxG10prX2WRtWzNmIkwlwe680ZuAJaGuGnQ5v0m5oDAfmHDAzVp2t4y6bghgUmquZy30uC2sQUCesex1G4_VCv2Pviq9dZhsws2r8oQPSxNek_0wJRJzoW7zPeFpUXyMLiCOFW3zq-pwZ3dAfW1r7nEWXoyodkIDcy_9qlLftFEr571eGI6NYa.Gon3VLFxrITyNIhlxsQWA93UsCXGzFDjC1s5fEWn1DQ&dib_tag=se&keywords=el%2Bestimado&qid=1785558657&sprefix=el%2Bestimado%2Caps%2C195&sr=8-2&linkCode=ll2&tag=axis0d-20&linkId=775d1b7212c51569ea627cc79a9b87eb&language=en_US&gaOptInStatus=true&ref_=as_li_ss_tl' },
];
const amazonShinanCosmology: AmazonEdition[] = [
  { label: 'English', url: 'https://www.amazon.com/Shinan-Cosmology-Shipibo-Kent-Osborn/dp/B0CVLM8LK3?crid=2KHQS2XNISLID&dib=eyJ2IjoiMSJ9.L0BaeCKDFUXbqcz-KeYLSKvsP0Ba7yspGB2gIVJ3EWkVPFdl3AytDFXUMHH3UOLt.LrrwXr7l9behB9EOdbK9p5n4H8XR1864VeuPYeJhmu0&dib_tag=se&keywords=Shinan%2Bcosmology&qid=1785558738&sprefix=shinan%2Bcosmology%2Caps%2C190&sr=8-1&linkCode=ll2&tag=axis0d-20&linkId=c099e577b1faf3dcb6432774ec449e57&language=en_US&gaOptInStatus=true&ref_=as_li_ss_tl' },
  { label: 'Español', url: 'https://www.amazon.com/Shinan-Cosmolog%C3%ADa-Tribu-Shipibo-Spanish/dp/B0D11LWD44?_encoding=UTF8&dib_tag=se&dib=eyJ2IjoiMSJ9.L0BaeCKDFUXbqcz-KeYLSKvsP0Ba7yspGB2gIVJ3EWkVPFdl3AytDFXUMHH3UOLt.LrrwXr7l9behB9EOdbK9p5n4H8XR1864VeuPYeJhmu0&qid=1785558820&sr=8-5&linkCode=ll2&tag=axis0d-20&linkId=2c42fd2b1c85c64cd683fc9b6185856e&language=en_US&gaOptInStatus=true&ref_=as_li_ss_tl' },
];

// One row per PACKAGING — its own photo and price — with the language editions
// it is sold in listed inside the row. Packaging is what the photo shows and
// what the price depends on; language changes neither, so it earns a token
// rather than a duplicate row.
//
// Slugs identify a packaging; a selectable item is packaging + edition, keyed
// `<slug>--<edition>`. `group` ties variants to a title and is what ?item=
// deep-links target, so existing links like /order?item=shinan still work.
// `amazon` (books only) adds an alternate-route strip under the row; it never
// replaces the checkboxes, so "send me two copies" still goes straight to Kent.
const groups: Group[] = [
  {
    key: 'shinan',
    name: i.order.productShinan,
    note: i.order.productShinanNote,
    variants: [
      { slug: 'shinan-box', label: i.order.variantBox, usd: 50, mxn: 900, box: true,
        editions: ['bilingual'],
        img: 'https://res.cloudinary.com/dmzx8w015/image/upload/v1782523000/shinan_oracle_hardcase_orange_vy4kmr.jpg' },
      { slug: 'shinan-bag-wine', label: i.order.variantBagWine, usd: 40, mxn: 700, box: false,
        editions: ['bilingual'],
        img: 'https://res.cloudinary.com/dmzx8w015/image/upload/shinan_oracle_bag_wine_br7ny1.jpg' },
    ],
  },
  {
    key: 'magnetic-magi',
    name: i.order.productMagneticMagi,
    note: i.order.productMagneticMagiNote,
    variants: [
      // The box IS the bilingual edition — which is what the higher price pays for.
      { slug: 'mm-box', label: i.order.variantBox, usd: 50, mxn: 900, box: true,
        editions: ['bilingual'],
        img: 'https://res.cloudinary.com/dmzx8w015/image/upload/v1782522608/mm_hardcase_rs5wco.jpg' },
      { slug: 'mm-bag-wine', label: i.order.variantBagWine, usd: 40, mxn: 700, box: false,
        editions: ['es', 'en'],
        img: 'https://res.cloudinary.com/dmzx8w015/image/upload/v1782522608/mm_wine_bag_mixed_background_o4ydod.jpg' },
      { slug: 'mm-bag-purple', label: i.order.variantBagPurple, usd: 40, mxn: 700, box: false,
        editions: ['es', 'en'],
        img: 'https://res.cloudinary.com/dmzx8w015/image/upload/v1782522608/mm_purple_bag_gray_background_wrlixz.jpg' },
    ],
  },
  {
    key: 'worlds-within',
    name: i.order.productWorldsWithin,
    note: i.order.productWorldsWithinNote,
    variants: [
      { slug: 'worlds-within', label: i.order.variantDeckPreorder, usd: 40, mxn: 700, box: false,
        editions: ['es', 'en'],
        img: 'https://res.cloudinary.com/dmzx8w015/image/upload/v1785524243/Worlds_within_cover_image_vaafyq.jpg' },
    ],
  },
  {
    key: 'el-estimado',
    name: i.order.productElEstimado,
    note: i.order.productElEstimadoNote,
    variants: [
      { slug: 'el-estimado', label: i.order.variantBook, usd: 20, mxn: 340, box: false,
        editions: ['en', 'es'],
        img: '/images/el-estimado-front.jpg', amazon: amazonElEstimado },
    ],
  },
  {
    key: 'shinan-cosmology',
    name: i.order.productShinanCosmology,
    note: i.order.productShinanCosmologyNote,
    variants: [
      { slug: 'shinan-cosmology', label: i.order.variantBook, usd: 20, mxn: 340, box: false,
        editions: ['en', 'es'],
        img: 'https://res.cloudinary.com/dmzx8w015/image/upload/v1781919010/shinan-cosmology_hdr7in.jpg',
        amazon: amazonShinanCosmology },
    ],
  },
];

// One Netlify form per locale. Netlify registers a form once per NAME and then
// resolves the pretty labels in its notification emails from whichever page it
// parsed — so while /order and /es/order shared the name "order-request", every
// notification came out with Spanish labels regardless of the language the
// buyer actually used, and nothing in the email said which it was. Separate
// names give each locale its own labels, and the form name itself now tells you
// which page the order came from.
//
// English deliberately keeps the original name so its submission history stays
// on the existing form.
const formName = lang === 'es' ? 'order-request-es' : 'order-request';

const inputClass =
  'w-full border border-brand-warm-gray rounded px-4 py-2 focus:outline-none focus:ring-2 focus:ring-brand-gold';
---

<form
  name={formName}
  method="POST"
  data-netlify="true"
  netlify-honeypot="bot-field"
  class="max-w-2xl mx-auto space-y-8"
  data-order-form
>
  <input type="hidden" name="form-name" value={formName} />
  <input type="hidden" name="subject" data-subject-field value="" />
  <input type="hidden" name="enquiry_id" data-enquiry-field value="" />
  <!-- What was actually ordered, as one readable block. Netlify prints every
       registered field in its notification email, empty ones included, so a
       field per variant meant the real order sat buried under a dozen blank
       "Item …"/"Qty …" rows — and worsened with every product added. The
       per-variant inputs are therefore nameless (they drive the UI only, via
       their data- attributes) and this single field carries the order. Filled
       on submit, same as the two hidden fields above. -->
  <input
    type="hidden"
    name="order_summary"
    data-summary-field
    data-subtotal-label={i.order.subtotalLabel}
    data-subtotal-note={i.order.subtotalNote}
    value=""
  />
  <!-- Where this enquiry came from, assembled from the first-touch record that
       Layout.astro writes on the visitor's first pageview. One field rather than
       four, for the same reason order_summary is one field: Netlify prints every
       registered field including the empty ones. -->
  <input type="hidden" name="how_they_arrived" data-arrival-field value="" />
  <p class="hidden" aria-hidden="true">
    <label>Don't fill this out if you're human: <input name="bot-field" /></label>
  </p>

  <fieldset>
    <legend class="block font-heading text-lg mb-2">{i.order.productsLegend}</legend>
    <p class="text-sm text-brand-dark/85 mb-1">{i.order.availabilityNote}</p>
    <p class="text-sm text-brand-dark/85 mb-1">{i.order.batchNote}</p>
    <!-- Stated up front AND repeated in every deck label. A buyer read this page
         end to end and still had to write in asking whether the deck came with
         the book, so once is demonstrably not enough. -->
    <p class="text-sm font-medium text-brand-dark mb-5">{i.order.guidebookNote}</p>

    <div class="space-y-8">
      {groups.map((group) => (
        <div id={`group-${group.key}`} data-group-block class="scroll-mt-24">
          <h3 class="font-heading text-base text-brand-dark">{group.name}</h3>
          <p class="text-sm text-brand-dark/60 mb-3">{group.note}</p>
          <div class="space-y-3">
            {group.variants.map((v) => (
              <div class="rounded border border-brand-warm-gray/60 px-3 py-3" data-variant-row>
                <div class="sm:flex sm:items-center sm:gap-4">
                <div class="flex items-center gap-3 sm:grow sm:min-w-0">
                <button
                  type="button"
                  data-img-trigger
                  data-full={cld(v.img, FULL)}
                  data-caption={`${group.name} — ${v.label}`}
                  aria-label={i.order.viewLarger}
                  class="shrink-0 cursor-zoom-in rounded ring-1 ring-brand-warm-gray/40 bg-brand-light overflow-hidden focus:outline-none focus:ring-2 focus:ring-brand-gold"
                >
                  <img
                    src={cld(v.img, THUMB)}
                    alt={`${group.name} — ${v.label}`}
                    width="112"
                    height="112"
                    loading="lazy"
                    class="w-24 h-24 md:w-28 md:h-28 object-contain"
                  />
                </button>
                <span class="grow">
                  <span class="block font-medium leading-tight">{v.label}</span>
                  {v.usd && <span class="block text-sm text-brand-dark/70">${v.usd} USD · ${v.mxn} MXN</span>}
                  {v.box && (
                    <span class="inline-block mt-1 text-[11px] uppercase tracking-wide text-brand-rust">
                      {i.order.availabilityTag}
                    </span>
                  )}
                </span>
                </div>

                {/* Editions. Quantity sits beside the edition it belongs to, which
                    is what lets one order mix languages.
                    From sm up these stack in the row's right-hand column — the
                    gutter the old single quantity box used to occupy. Stacked
                    rather than in a line, because a vertical stack of up to three
                    tokens is shorter than the 112px thumbnail, so the row costs no
                    extra height at all; a horizontal line of them would not fit
                    beside the label.
                    Below sm they drop under the row: at 375px only ~210px remains
                    once the thumbnail is placed, and a token column needs ~160px
                    of that, which would leave nothing for the product name.
                    Every row carries this, even where only one edition exists — a
                    lone "Bilingual" token answers "which language is this?" in
                    place, and makes the neighbouring rows' choices legible by
                    contrast. */}
                <div class="mt-3 pt-3 border-t border-brand-warm-gray/30 sm:mt-0 sm:pt-0 sm:border-t-0 sm:shrink-0">
                  <span class="block text-[11px] uppercase tracking-wide text-brand-dark/55 mb-2">
                    {i.order.editionLabel}
                  </span>
                  <div class="flex flex-wrap gap-x-5 gap-y-3 sm:flex-col sm:flex-nowrap sm:items-start sm:gap-2">
                    {v.editions.map((edition) => (
                      <span class="flex items-center gap-2">
                        <label class="flex items-center gap-2 cursor-pointer">
                          <input
                            type="checkbox"
                            value={`${group.name} — ${v.label} (${editionLabels[edition]})${v.usd ? ` ($${v.usd} USD / $${v.mxn} MXN)` : ''}`}
                            data-item={`${v.slug}--${edition}`}
                            data-group={group.key}
                            data-usd={v.usd ?? 0}
                            data-mxn={v.mxn ?? 0}
                            class="h-4 w-4 accent-brand-purple"
                          />
                          <span class="text-sm">{editionLabels[edition]}</span>
                        </label>
                        <input
                          type="number"
                          value="1"
                          min="1"
                          max="9"
                          inputmode="numeric"
                          disabled
                          data-qty={`${v.slug}--${edition}`}
                          aria-label={`${i.order.quantityLabel} — ${group.name} ${v.label} ${editionLabels[edition]}`}
                          class="w-14 border border-brand-warm-gray rounded px-2 py-1 text-center text-sm disabled:opacity-40"
                        />
                      </span>
                    ))}
                  </div>
                </div>
                </div>
                {v.amazon && (
                  /* Alternate route, not a replacement: the checkboxes above still send
                     "two copies of El Estimado" straight to Kent. This stays full width
                     BELOW the row at every breakpoint, deliberately not joining the
                     editions in the right-hand column: an edition token is a selection
                     that belongs to this row, while these are a route away from the form
                     entirely, and the two should not read as the same kind of control.
                     It also cannot sit inside a label — the label wraps the checkbox, so
                     an <a> there would tick the box on the way out. Outline pills, never
                     filled: solid buttons would out-shout the one real submit button. */
                  <div class="mt-3 pt-3 border-t border-brand-warm-gray/30 flex flex-wrap items-center gap-x-3 gap-y-2">
                    <span class="text-sm text-brand-dark/70">{i.order.amazonInvite}</span>
                    <span class="flex gap-2 shrink-0">
                      {v.amazon.map((edition) => (
                        <a
                          href={edition.url}
                          target="_blank"
                          rel="noopener noreferrer"
                          class="inline-flex items-center gap-1.5 rounded border border-brand-warm-gray/60 px-3 py-2 text-sm leading-5 text-brand-dark/80 transition-colors hover:border-brand-gold hover:text-brand-gold focus:outline-none focus:ring-2 focus:ring-brand-gold"
                        >
                          {edition.label}
                          <span aria-hidden="true">↗</span>
                          <span class="sr-only">({i.order.amazonNewTab})</span>
                        </a>
                      ))}
                    </span>
                  </div>
                )}
              </div>
            ))}
          </div>
        </div>
      ))}
    </div>

    <div data-subtotal-row hidden class="mt-5 flex items-baseline justify-between border-t border-brand-warm-gray/40 pt-3">
      <span class="font-medium">{i.order.subtotalLabel}</span>
      <span class="text-right">
        <span class="font-heading text-lg">$<span data-subtotal-usd>0</span> USD · $<span data-subtotal-mxn>0</span> MXN</span>
        <span class="block text-xs text-brand-dark/60">{i.order.subtotalNote}</span>
      </span>
    </div>

    <p data-product-error hidden class="text-sm text-red-700 mt-2">{i.order.productRequired}</p>

    <!-- Required by the Amazon Associates operating agreement wherever a `tag=`
         affiliate link appears. Stated once for the page, not per book tile. -->
    <p class="mt-5 text-xs text-brand-dark/55">{i.order.amazonDisclosure}</p>
  </fieldset>

  {/* autocomplete tokens matter more than they look. Without them the browser
      falls back to guessing from the field name, and a field simply called
      "address" gets matched to address-line2 — the apartment/unit line — so
      autofill drops in "int 303" and nothing else. These are the spec tokens;
      "shipping" scopes the group so the browser offers a shipping address
      rather than a billing one. Note street-address covers the street lines
      ONLY: city, state and postcode have their own tokens and cannot autofill
      into a single free-text box. */}
  <div>
    <label for="order-country" class="block text-sm font-medium mb-1">{i.order.countryLabel}</label>
    <input type="text" id="order-country" name="country" required autocomplete="shipping country-name" class={inputClass} />
  </div>

  <div>
    <label for="order-name" class="block text-sm font-medium mb-1">{i.order.nameLabel}</label>
    <input type="text" id="order-name" name="name" required autocomplete="name" class={inputClass} />
  </div>

  <div>
    <label for="order-email" class="block text-sm font-medium mb-1">{i.order.emailLabel}</label>
    <input type="email" id="order-email" name="email" required inputmode="email" autocomplete="email" class={inputClass} />
  </div>

  <div>
    <label for="order-address" class="block text-sm font-medium mb-1">{i.order.addressLabel}</label>
    <textarea id="order-address" name="address" rows="3" autocomplete="shipping street-address" class={inputClass}></textarea>
    <p class="text-sm text-brand-dark/60 mt-1">{i.order.addressHint}</p>
  </div>

  <div>
    <label for="order-notes" class="block text-sm font-medium mb-1">{i.order.notesLabel}</label>
    <textarea id="order-notes" name="notes" rows="3" class={inputClass}></textarea>
  </div>

  <div class="space-y-2 text-sm text-brand-dark/70">
    <p>{i.order.currencyNote}</p>
    <p>{i.order.privacyNote}</p>
  </div>

  <button
    type="submit"
    data-submit-button
    data-label-sending={i.order.sending}
    class="bg-brand-dark text-white px-8 py-3 rounded hover:bg-brand-gold transition-colors uppercase tracking-wide text-sm disabled:opacity-60 disabled:cursor-not-allowed"
  >
    {i.order.submitButton}
  </button>
  <p data-form-error hidden class="text-sm text-red-700">{i.order.errorText}</p>
</form>

<div data-order-success hidden class="max-w-xl mx-auto text-center py-8">
  <p class="text-2xl font-heading text-brand-dark mb-3">{i.order.successHeading}</p>
  <p class="text-lg leading-relaxed mb-6">{i.order.successText}</p>
  <p class="text-sm uppercase tracking-[0.2em] text-brand-dark/60 mb-1">{i.order.successIdLabel}</p>
  <p data-success-id class="text-3xl font-heading text-brand-purple mb-4"></p>
  <p class="text-sm text-brand-dark/70 max-w-md mx-auto">{i.order.successIdHint}</p>
</div>

<dialog data-img-modal class="img-modal" aria-label={i.order.viewLarger}>
  <div class="img-modal-inner">
    <button type="button" data-img-close class="img-modal-close" aria-label={i.order.closeLabel}>
      <span aria-hidden="true">×</span>
    </button>
    <img data-img-modal-pic src="" alt="" />
  </div>
</dialog>

<style>
  /* Selected-variant feedback: a checked row gets a purple edge + faint tint,
     so selection reads at a glance among several rows (not just the checkbox). */
  [data-variant-row]:has(input[data-item]:checked) {
    border-color: #34045c;
    background: rgba(52, 4, 92, 0.05);
  }

  .img-modal {
    /* Tailwind's preflight zeroes margin on every element, which kills the
       native dialog centering (browsers center modals via margin:auto). Restore
       it explicitly so the lightbox sits centered, not pinned top-left. */
    position: fixed;
    inset: 0;
    margin: auto;
    border: none;
    padding: 0;
    background: transparent;
    max-width: 92vw;
    max-height: 90vh;
    overflow: visible;
  }
  .img-modal::backdrop {
    background: rgba(20, 6, 36, 0.72);
    backdrop-filter: blur(2px);
    -webkit-backdrop-filter: blur(2px);
  }
  .img-modal[open] { animation: img-modal-in 0.25s ease-out both; }
  @keyframes img-modal-in {
    from { opacity: 0; transform: scale(0.97); }
    to   { opacity: 1; transform: scale(1); }
  }
  .img-modal-inner { position: relative; }
  .img-modal-pic, .img-modal img {
    display: block;
    max-width: 92vw;
    max-height: 90vh;
    border-radius: 8px;
    box-shadow: 0 30px 80px -20px rgba(0, 0, 0, 0.7);
  }
  .img-modal-close {
    position: absolute;
    top: -16px;
    right: -16px;
    width: 42px;
    height: 42px;
    border-radius: 9999px;
    border: none;
    cursor: pointer;
    background: #fff;
    color: #2a1e10;
    font-size: 1.5rem;
    line-height: 1;
    box-shadow: 0 10px 30px -8px rgba(0, 0, 0, 0.5);
    transition: transform 0.2s ease, background 0.2s ease;
  }
  .img-modal-close:hover { background: #ffd773; transform: rotate(90deg); }
  .img-modal-close:focus-visible { outline: 2px solid #ffd773; outline-offset: 3px; }
  @media (prefers-reduced-motion: reduce) {
    .img-modal[open] { animation: none; }
    .img-modal-close { transition: none; }
    .img-modal-close:hover { transform: none; }
  }
</style>

<script>
  const form = document.querySelector<HTMLFormElement>('[data-order-form]');
  const success = document.querySelector<HTMLElement>('[data-order-success]');

  // Fire GA4 events only when gtag exists (it is hostname-gated to the
  // canonical domain in Layout.astro).
  function track(event: string, params: Record<string, unknown>) {
    const w = window as unknown as { gtag?: (...args: unknown[]) => void };
    if (typeof w.gtag === 'function') w.gtag('event', event, params);
  }

  // Unambiguous alphabet: no 0/O, 1/I/L to keep IDs easy to read back.
  function makeEnquiryId(): string {
    const alphabet = '23456789ABCDEFGHJKMNPQRSTUVWXYZ';
    const bytes = new Uint8Array(6);
    crypto.getRandomValues(bytes);
    let id = 'ORD-';
    bytes.forEach((b) => (id += alphabet[b % alphabet.length]));
    return id;
  }

  // Image lightbox: one shared <dialog>, populated from the clicked thumbnail.
  // showModal() gives Escape-to-close natively; we add a close button + backdrop click.
  const imgModal = document.querySelector<HTMLDialogElement>('[data-img-modal]');
  const imgModalPic = document.querySelector<HTMLImageElement>('[data-img-modal-pic]');
  if (imgModal && imgModalPic) {
    document.querySelectorAll<HTMLButtonElement>('[data-img-trigger]').forEach((btn) => {
      btn.addEventListener('click', () => {
        imgModalPic.src = btn.dataset.full ?? '';
        imgModalPic.alt = btn.dataset.caption ?? '';
        if (typeof imgModal.showModal === 'function') imgModal.showModal();
      });
    });
    imgModal.querySelector<HTMLButtonElement>('[data-img-close]')?.addEventListener('click', () => imgModal.close());
    imgModal.addEventListener('click', (event) => {
      if (event.target === imgModal) imgModal.close();
    });
  }

  if (form) {
    const boxes = Array.from(form.querySelectorAll<HTMLInputElement>('[data-item]'));
    const subtotalRow = form.querySelector<HTMLElement>('[data-subtotal-row]');
    const subtotalUsd = form.querySelector<HTMLElement>('[data-subtotal-usd]');
    const subtotalMxn = form.querySelector<HTMLElement>('[data-subtotal-mxn]');
    const productError = form.querySelector<HTMLElement>('[data-product-error]');

    function recomputeSubtotal() {
      let usd = 0;
      let mxn = 0;
      boxes.forEach((box) => {
        if (!box.checked) return;
        const priceUsd = Number(box.dataset.usd || 0);
        const priceMxn = Number(box.dataset.mxn || 0);
        if (!priceUsd && !priceMxn) return;
        const qty = form!.querySelector<HTMLInputElement>(`[data-qty="${box.dataset.item}"]`);
        const n = Math.max(1, Number(qty?.value || 1));
        usd += priceUsd * n;
        mxn += priceMxn * n;
      });
      if (subtotalUsd) subtotalUsd.textContent = String(usd);
      if (subtotalMxn) subtotalMxn.textContent = String(mxn);
      if (subtotalRow) subtotalRow.hidden = usd === 0 && mxn === 0;
    }

    boxes.forEach((box) => {
      box.addEventListener('change', () => {
        const qty = form.querySelector<HTMLInputElement>(`[data-qty="${box.dataset.item}"]`);
        if (qty) qty.disabled = !box.checked;
        if (box.checked && productError) productError.hidden = true;
        recomputeSubtotal();
      });
    });
    form.querySelectorAll<HTMLInputElement>('[data-qty]').forEach((qty) => {
      qty.addEventListener('input', recomputeSubtotal);
    });

    // ?item=<group key> scrolls to and highlights the title. It no longer
    // auto-checks anything: now that every item carries a language edition,
    // even the single-packaging titles offer a real choice, and picking one for
    // the buyer would mean guessing which language they read.
    const preselect = new URLSearchParams(location.search).get('item');
    if (preselect) {
      const block = document.getElementById(`group-${preselect}`);
      if (block) {
        block.scrollIntoView({ behavior: 'smooth', block: 'center' });
        block.animate(
          [{ backgroundColor: 'rgba(208,172,104,0.25)' }, { backgroundColor: 'transparent' }],
          { duration: 1600, easing: 'ease-out' }
        );
      }
    }

    // Funnel signal: visitor began filling the form (fires once).
    form.addEventListener(
      'focusin',
      () => track('order_form_started', { language: document.documentElement.lang }),
      { once: true }
    );

    form.addEventListener('submit', async (event) => {
      event.preventDefault();

      const checked = boxes.filter((b) => b.checked);
      if (checked.length === 0) {
        if (productError) productError.hidden = false;
        return;
      }

      const button = form.querySelector<HTMLButtonElement>('[data-submit-button]');
      const error = form.querySelector<HTMLElement>('[data-form-error]');
      if (error) error.hidden = true;
      const label = button?.textContent ?? '';
      if (button) {
        button.disabled = true;
        button.textContent = button.dataset.labelSending ?? label;
      }

      const enquiryId = makeEnquiryId();
      const country = form.querySelector<HTMLInputElement>('[name="country"]')?.value.trim() ?? '';
      const idField = form.querySelector<HTMLInputElement>('[data-enquiry-field]');
      const subjectField = form.querySelector<HTMLInputElement>('[data-subject-field]');

      // Totals are computed here rather than inside the summary block because the
      // subject line needs them too — an inbox should be triageable without
      // opening anything.
      let usdTotal = 0;
      let mxnTotal = 0;
      checked.forEach((box) => {
        const qtyInput = form.querySelector<HTMLInputElement>(`[data-qty="${box.dataset.item}"]`);
        const qty = Math.max(1, Number(qtyInput?.value || 1));
        usdTotal += Number(box.dataset.usd || 0) * qty;
        mxnTotal += Number(box.dataset.mxn || 0) * qty;
      });

      // The order itself, as the one field a human actually reads. Each checkbox
      // still carries its full "Title — Variant ($X USD / $Y MXN)" string as its
      // value; it just no longer has a name, so it never reaches Netlify on its
      // own. Priced lines get a running total appended.
      const summaryField = form.querySelector<HTMLInputElement>('[data-summary-field]');
      if (summaryField) {
        const lines = checked.map((box) => {
          const qtyInput = form.querySelector<HTMLInputElement>(`[data-qty="${box.dataset.item}"]`);
          const qty = Math.max(1, Number(qtyInput?.value || 1));
          return `${qty} × ${box.value}`;
        });
        if (usdTotal || mxnTotal) {
          // Localised via data- attributes: this runs as a plain client script
          // and has no access to the i18n helper. Reuses the same two strings
          // the on-page subtotal row shows.
          const subtotalLabel = summaryField.dataset.subtotalLabel ?? 'Estimated deck subtotal';
          const subtotalNote = summaryField.dataset.subtotalNote ?? 'before shipping';
          lines.push(`— ${subtotalLabel}: $${usdTotal} USD / $${mxnTotal} MXN (${subtotalNote})`);
        }
        summaryField.value = lines.join('\n');
      }

      // Where they came from, as one readable block.
      const arrivalField = form.querySelector<HTMLInputElement>('[data-arrival-field]');
      if (arrivalField) {
        let visit: { host?: string; utm?: Record<string, string>; landing?: string; at?: string; pages?: number } | null = null;
        try {
          const raw = sessionStorage.getItem('kentchi:first-touch');
          if (raw) visit = JSON.parse(raw);
        } catch {
          /* storage unavailable — fall through to the unknown case */
        }
        const rows: string[] = [];
        const utm = visit?.utm ?? {};
        if (utm.source) {
          // A tagged link: exact attribution, so report it and nothing vaguer.
          rows.push(`Source:       ${[utm.source, utm.medium, utm.campaign].filter(Boolean).join(' · ')} (tagged link)`);
        } else if (visit?.host) {
          const searchEngine = /(^|\.)(google|bing|duckduckgo|yahoo|ecosia|brave)\./.test(`${visit.host}.`);
          rows.push(
            `Source:       ${visit.host}` +
              (searchEngine ? ' (organic — search engines do not disclose the terms)' : '')
          );
        } else {
          rows.push('Source:       direct or in-app link (no referrer)');
        }
        if (visit?.landing) rows.push(`Landed on:    ${visit.landing}`);
        rows.push(`Ordered from: ${location.pathname}${location.search}`);
        if (visit?.at) {
          const when = new Date(visit.at);
          const pages = visit.pages ?? 1;
          rows.push(
            `First visit:  ${when.toLocaleString()} (${pages} page${pages === 1 ? '' : 's'} this visit)`
          );
        }
        arrivalField.value = rows.join('\n');
      }

      if (idField) idField.value = enquiryId;
      // Netlify uses a field literally named "subject" as the notification's
      // subject line. The estimate goes here so a full inbox can be triaged
      // without opening anything — a $600 order and a $40 one should not look
      // alike in the list. USD only: both currencies push the line past the
      // ~60 characters most clients show, and the body carries both anyway.
      if (subjectField) {
        const estimate = usdTotal ? ` — $${usdTotal} USD` : '';
        subjectField.value = `ORDER REQUEST [${enquiryId}] — ${country}${estimate}`;
      }

      try {
        const body = new URLSearchParams(new FormData(form) as unknown as Record<string, string>).toString();
        const res = await fetch('/', {
          method: 'POST',
          headers: { 'Content-Type': 'application/x-www-form-urlencoded' },
          body,
        });
        if (!res.ok) throw new Error(`Form POST failed: ${res.status}`);

        track('order_request_submitted', {
          enquiry_id: enquiryId,
          country,
          items: checked.map((c) => c.dataset.item).join(','),
          language: document.documentElement.lang,
        });

        const idOut = document.querySelector<HTMLElement>('[data-success-id]');
        if (idOut) idOut.textContent = enquiryId;
        form.hidden = true;
        if (success) success.hidden = false;
        success?.scrollIntoView({ behavior: 'smooth', block: 'center' });
      } catch {
        if (error) error.hidden = false;
        if (button) {
          button.disabled = false;
          button.textContent = label;
        }
      }
    });
  }
</script>
